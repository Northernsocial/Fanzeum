rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'fifestreet@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidCategory(cat) {
      return cat is string && cat.size() <= 32 && cat in [
        'stamps',
        'football_cards',
        'trading_cards',
        'coins',
        'comics',
        'vinyl',
        'toys',
        'memorabilia'
      ];
    }

    function isValidVisibility(vis) {
      return vis is string && vis.size() <= 16 && vis in ['public', 'followers', 'private'];
    }

    function isValidMediaCredit(mc) {
      return mc is map &&
        mc.keys().hasAll(['sourceUrl', 'author', 'licence']) &&
        mc.keys().hasOnly(['sourceUrl', 'author', 'licence']) &&
        mc.sourceUrl is string && mc.sourceUrl.size() <= 512 &&
        mc.author is string && mc.author.size() <= 160 &&
        mc.licence is string && mc.licence.size() <= 80;
    }

    function isValidPhotoEntry(photo) {
      return photo is map &&
        photo.keys().hasAll(['url', 'thumbUrl', 'width', 'height']) &&
        photo.keys().hasOnly(['url', 'thumbUrl', 'width', 'height', 'label', 'blurDataUrl']) &&
        photo.url is string && photo.url.size() >= 1 && photo.url.size() <= 2048 &&
        photo.thumbUrl is string && photo.thumbUrl.size() >= 1 && photo.thumbUrl.size() <= 2048 &&
        photo.width is int && photo.width >= 1 && photo.width <= 12000 &&
        photo.height is int && photo.height >= 1 && photo.height <= 12000 &&
        (!('label' in photo) || (photo.label is string && photo.label.size() <= 40)) &&
        (!('blurDataUrl' in photo) || (photo.blurDataUrl is string && photo.blurDataUrl.size() <= 600));
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'handle',
          'displayName',
          'bio',
          'avatarUrl',
          'location',
          'specialties',
          'goal',
          'role',
          'plan',
          'isVerifiedExpert',
          'isPublicProfile',
          'hideValues',
          'hideLocation',
          'onboardingCompleted',
          'collectionsCount',
          'piecesCount',
          'joinedLabel',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'handle',
          'displayName',
          'bio',
          'avatarUrl',
          'location',
          'specialties',
          'goal',
          'role',
          'plan',
          'isVerifiedExpert',
          'isPublicProfile',
          'hideValues',
          'hideLocation',
          'onboardingCompleted',
          'collectionsCount',
          'piecesCount',
          'joinedLabel',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 32 && data.handle.matches('^[a-z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.bio is string && data.bio.size() <= 600 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 2048 &&
        data.location is string && data.location.size() <= 80 &&
        data.specialties is list && data.specialties.size() <= 10 &&
        (data.specialties.size() == 0 || (data.specialties[0] is string && data.specialties[0].size() <= 32)) &&
        data.goal is string && data.goal.size() <= 24 && data.goal in ['exhibit', 'complete_set', 'sell', 'learn'] &&
        data.role is string && data.role.size() <= 16 && data.role in ['collector', 'expert', 'store', 'admin'] &&
        data.plan is string && data.plan.size() <= 16 && data.plan in ['free', 'premium', 'store'] &&
        data.isVerifiedExpert is bool &&
        data.isPublicProfile is bool &&
        data.hideValues is bool &&
        data.hideLocation is bool &&
        data.onboardingCompleted is bool &&
        data.collectionsCount is int && data.collectionsCount >= 0 && data.collectionsCount <= 10000 &&
        data.piecesCount is int && data.piecesCount >= 0 && data.piecesCount <= 100000 &&
        data.joinedLabel is string && data.joinedLabel.size() <= 40 &&
        data.isDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPrivateAccount (PII Isolated)
    function isValidUserPrivateAccount(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'analyticsConsent',
          'marketingConsent',
          'aiTrainingOptOut',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'analyticsConsent',
          'marketingConsent',
          'aiTrainingOptOut',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.analyticsConsent is bool &&
        data.marketingConsent is bool &&
        data.aiTrainingOptOut is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ItemPrivateRecord (Owner-only purchase price & notes)
    function isValidItemPrivateRecord(data) {
      return data.keys().hasAll([
          'uid',
          'itemId',
          'acquiredDate',
          'acquiredPriceGbp',
          'privateNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'itemId',
          'acquiredDate',
          'acquiredPriceGbp',
          'privateNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidId(data.itemId) &&
        data.acquiredDate is string && data.acquiredDate.size() <= 40 &&
        (data.acquiredPriceGbp is int || data.acquiredPriceGbp is float) && data.acquiredPriceGbp >= 0 && data.acquiredPriceGbp <= 100000000 &&
        data.privateNotes is string && data.privateNotes.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Collection
    function isValidCollection(data) {
      return data.keys().hasAll([
          'ownerId',
          'ownerName',
          'ownerHandle',
          'title',
          'story',
          'coverImageUrl',
          'category',
          'visibility',
          'itemCount',
          'setTargetCount',
          'estimatedTotalMinGbp',
          'estimatedTotalMaxGbp',
          'featured',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'ownerHandle',
          'title',
          'story',
          'coverImageUrl',
          'category',
          'visibility',
          'itemCount',
          'setTargetCount',
          'estimatedTotalMinGbp',
          'estimatedTotalMaxGbp',
          'featured',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80 &&
        data.ownerHandle is string && data.ownerHandle.size() >= 2 && data.ownerHandle.size() <= 32 && data.ownerHandle.matches('^[a-z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.story is string && data.story.size() <= 2500 &&
        data.coverImageUrl is string && data.coverImageUrl.size() <= 2048 &&
        isValidCategory(data.category) &&
        isValidVisibility(data.visibility) &&
        data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 50000 &&
        data.setTargetCount is int && data.setTargetCount >= 0 && data.setTargetCount <= 50000 &&
        (data.estimatedTotalMinGbp is int || data.estimatedTotalMinGbp is float) && data.estimatedTotalMinGbp >= 0 &&
        (data.estimatedTotalMaxGbp is int || data.estimatedTotalMaxGbp is float) && data.estimatedTotalMaxGbp >= data.estimatedTotalMinGbp &&
        data.featured is bool &&
        data.isDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: PanelChatRecord (Owner-only AI Expert Panel chat)
    function isValidPanelChatMessage(msg) {
      return msg is map &&
        msg.keys().hasAll(['id', 'role', 'text', 'personaId', 'createdAt']) &&
        msg.keys().hasOnly(['id', 'role', 'text', 'personaId', 'imageUrls', 'createdAt']) &&
        msg.id is string && msg.id.size() >= 1 && msg.id.size() <= 128 &&
        msg.role is string && msg.role in ['user', 'assistant', 'lead'] &&
        msg.text is string && msg.text.size() <= 5000 &&
        msg.personaId is string && msg.personaId.size() <= 64 &&
        (!('imageUrls' in msg) || (msg.imageUrls is list && msg.imageUrls.size() <= 4)) &&
        msg.createdAt is string && msg.createdAt.size() <= 64;
    }

    function isValidPanelCard(card) {
      return card is map &&
        card.keys().hasAll(['title', 'category', 'conditionGuess', 'valueMinGbp', 'valueMaxGbp', 'valuationReason', 'overallConfidence', 'fields']) &&
        card.keys().hasOnly(['title', 'category', 'conditionGuess', 'valueMinGbp', 'valueMaxGbp', 'valuationReason', 'overallConfidence', 'fields']) &&
        card.title is string && card.title.size() <= 140 &&
        isValidCategory(card.category) &&
        card.conditionGuess is string && card.conditionGuess.size() <= 80 &&
        (card.valueMinGbp is int || card.valueMinGbp is float) && card.valueMinGbp >= 0 &&
        (card.valueMaxGbp is int || card.valueMaxGbp is float) && card.valueMaxGbp >= card.valueMinGbp &&
        card.valuationReason is string && card.valuationReason.size() <= 320 &&
        card.overallConfidence is string && card.overallConfidence in ['high', 'medium', 'low'] &&
        card.fields is map && card.fields.size() <= 30;
    }

    function isValidPanelChatRecord(data) {
      return data.keys().hasAll([
          'ownerId',
          'personaId',
          'messages',
          'summary',
          'card',
          'confidence',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'personaId',
          'messages',
          'summary',
          'card',
          'confidence',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.personaId is string && data.personaId.size() <= 64 &&
        data.messages is list && data.messages.size() <= 100 &&
        (data.messages.size() == 0 || isValidPanelChatMessage(data.messages[0])) &&
        data.summary is string && data.summary.size() <= 4000 &&
        isValidPanelCard(data.card) &&
        data.confidence is string && data.confidence in ['high', 'medium', 'low'] &&
        data.status is string && data.status in ['active', 'saved', 'closed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: FollowRecord (Owner-only category and collector follows)
    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'targetType', 'targetId', 'createdAt']) &&
        data.keys().hasOnly(['followerId', 'targetType', 'targetId', 'createdAt']) &&
        isValidId(data.followerId) &&
        data.targetType is string && data.targetType in ['category', 'user'] &&
        (
          (data.targetType == 'category' && isValidCategory(data.targetId)) ||
          (data.targetType == 'user' && isValidId(data.targetId))
        ) &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: ItemLike (One like per user per item)
    function isValidItemLike(data) {
      return data.keys().hasAll(['uid', 'itemId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'itemId', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidId(data.itemId) &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: ItemSave (One save per user per item bookmark)
    function isValidItemSave(data) {
      return data.keys().hasAll(['uid', 'itemId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'itemId', 'createdAt']) &&
        isValidId(data.uid) &&
        isValidId(data.itemId) &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: ItemComment (Plain text up to 1,000 characters)
    function isValidItemComment(data) {
      return data.keys().hasAll([
          'id',
          'itemId',
          'authorId',
          'authorName',
          'authorHandle',
          'authorAvatarUrl',
          'text',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'itemId',
          'authorId',
          'authorName',
          'authorHandle',
          'authorAvatarUrl',
          'text',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.itemId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 32 && data.authorHandle.matches('^[a-z0-9_\\-]+$') &&
        data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 2048 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Report (Admin read-only moderation report)
    function isValidReport(data) {
      return data.keys().hasAll([
          'reporterId',
          'targetType',
          'targetId',
          'itemId',
          'reason',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reporterId',
          'targetType',
          'targetId',
          'itemId',
          'reason',
          'createdAt'
        ]) &&
        isValidId(data.reporterId) &&
        data.targetType is string && data.targetType in ['comment', 'item', 'thread', 'reply'] &&
        isValidId(data.targetId) &&
        isValidId(data.itemId) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: CollectibleItem
    function isValidCollectibleItem(data) {
      return data.keys().hasAll([
          'collectionId',
          'ownerId',
          'ownerHandle',
          'category',
          'visibility',
          'title',
          'titleLower',
          'story',
          'imageUrl',
          'thumbUrl',
          'photos',
          'attributes',
          'fieldConfidences',
          'year',
          'maker',
          'setNumber',
          'condition',
          'valueMinGbp',
          'valueMaxGbp',
          'valuationReason',
          'aiConfidence',
          'grail',
          'tags',
          'customOrder',
          'forSale',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'collectionId',
          'ownerId',
          'ownerHandle',
          'category',
          'visibility',
          'title',
          'titleLower',
          'story',
          'imageUrl',
          'thumbUrl',
          'photos',
          'attributes',
          'fieldConfidences',
          'year',
          'maker',
          'setNumber',
          'condition',
          'valueMinGbp',
          'valueMaxGbp',
          'valuationReason',
          'aiConfidence',
          'grail',
          'tags',
          'customOrder',
          'forSale',
          'mediaCredit',
          'helpedBy',
          'panelStatus',
          'panelConfirmedAt',
          'isDemo',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.collectionId) &&
        isValidId(data.ownerId) &&
        data.ownerHandle is string && data.ownerHandle.size() >= 2 && data.ownerHandle.size() <= 32 && data.ownerHandle.matches('^[a-z0-9_\\-]+$') &&
        isValidCategory(data.category) &&
        isValidVisibility(data.visibility) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.titleLower is string && data.titleLower.size() >= 1 && data.titleLower.size() <= 140 &&
        data.story is string && data.story.size() <= 1500 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 2048 &&
        data.thumbUrl is string && data.thumbUrl.size() >= 1 && data.thumbUrl.size() <= 2048 &&
        data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 6 &&
        isValidPhotoEntry(data.photos[0]) &&
        data.attributes is map && data.attributes.size() <= 24 &&
        data.fieldConfidences is map && data.fieldConfidences.size() <= 24 &&
        data.year is string && data.year.size() <= 32 &&
        data.maker is string && data.maker.size() <= 120 &&
        data.setNumber is string && data.setNumber.size() <= 80 &&
        data.condition is string && data.condition.size() >= 1 && data.condition.size() <= 80 &&
        (data.valueMinGbp is int || data.valueMinGbp is float) && data.valueMinGbp >= 0 &&
        (data.valueMaxGbp is int || data.valueMaxGbp is float) && data.valueMaxGbp >= data.valueMinGbp &&
        data.valuationReason is string && data.valuationReason.size() <= 320 &&
        data.aiConfidence is string && data.aiConfidence.size() <= 16 && data.aiConfidence in ['high', 'medium', 'low', 'manual'] &&
        data.grail is bool &&
        data.tags is list && data.tags.size() <= 12 &&
        (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
        data.customOrder is int && data.customOrder >= 0 && data.customOrder <= 100000 &&
        data.forSale is bool &&
        (!('mediaCredit' in data) || isValidMediaCredit(data.mediaCredit)) &&
        (!('helpedBy' in data) || (data.helpedBy is string && data.helpedBy.size() <= 120)) &&
        (!('panelStatus' in data) || (data.panelStatus is string && data.panelStatus in ['none', 'confirmed', 'disputed'])) &&
        (!('panelConfirmedAt' in data) || (data.panelConfirmedAt is string && data.panelConfirmedAt.size() <= 64)) &&
        data.isDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: FreshFindRecord
    function isValidFreshFind(data) {
      return data.keys().hasAll([
          'itemId',
          'ownerId',
          'ownerHandle',
          'category',
          'title',
          'thumbUrl',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'itemId',
          'ownerId',
          'ownerHandle',
          'category',
          'title',
          'thumbUrl',
          'valueRange',
          'panelStatus',
          'isDemo',
          'createdAt'
        ]) &&
        isValidId(data.itemId) &&
        isValidId(data.ownerId) &&
        data.ownerHandle is string && data.ownerHandle.size() >= 2 && data.ownerHandle.size() <= 32 && data.ownerHandle.matches('^[a-z0-9_\\-]+$') &&
        isValidCategory(data.category) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.thumbUrl is string && data.thumbUrl.size() >= 1 && data.thumbUrl.size() <= 2048 &&
        (!('valueRange' in data) || (data.valueRange is string && data.valueRange.size() <= 80)) &&
        (!('panelStatus' in data) || (data.panelStatus is string && data.panelStatus in ['none', 'confirmed', 'disputed'])) &&
        (!('isDemo' in data) || data.isDemo is bool) &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: IdCorrectionRecord
    function isValidIdCorrection(data) {
      return data.keys().hasAll([
          'itemId',
          'itemOwnerId',
          'suggesterId',
          'suggesterHandle',
          'suggesterName',
          'suggestedCorrection',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'itemId',
          'itemOwnerId',
          'suggesterId',
          'suggesterHandle',
          'suggesterName',
          'suggestedCorrection',
          'note',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.itemId) &&
        isValidId(data.itemOwnerId) &&
        isValidId(data.suggesterId) &&
        data.suggesterHandle is string && data.suggesterHandle.size() >= 2 && data.suggesterHandle.size() <= 32 && data.suggesterHandle.matches('^[a-z0-9_\\-]+$') &&
        data.suggesterName is string && data.suggesterName.size() >= 1 && data.suggesterName.size() <= 80 &&
        data.suggestedCorrection is string && data.suggestedCorrection.size() >= 1 && data.suggestedCorrection.size() <= 200 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
        data.status is string && data.status in ['pending', 'accepted', 'dismissed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ItemSignalRecord (Got one / Want one)
    function isValidItemSignal(data) {
      return data.keys().hasAll(['itemId', 'userId', 'signalType', 'createdAt']) &&
        data.keys().hasOnly(['itemId', 'userId', 'signalType', 'createdAt']) &&
        isValidId(data.itemId) &&
        isValidId(data.userId) &&
        data.signalType is string && data.signalType in ['got', 'want'] &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: WantItemRecord
    function isValidWant(data) {
      return data.keys().hasAll(['userId', 'category', 'title', 'keyFields', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'category', 'title', 'keyFields', 'notes', 'maxPriceGbp', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        isValidCategory(data.category) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.keyFields is map && data.keyFields.size() <= 24 &&
        data.notes is string && data.notes.size() <= 1000 &&
        (!('maxPriceGbp' in data) || ((data.maxPriceGbp is int || data.maxPriceGbp is float) && data.maxPriceGbp >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: NotificationRecord
    function isValidNotification(data) {
      return data.keys().hasAll([
          'userId',
          'type',
          'title',
          'message',
          'itemId',
          'itemTitle',
          'itemCategory',
          'read',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'type',
          'title',
          'message',
          'itemId',
          'itemTitle',
          'itemCategory',
          'read',
          'createdAt'
        ]) &&
        isValidId(data.userId) &&
        data.type is string && data.type in ['want_match', 'id_correction_received', 'id_correction_accepted'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        isValidId(data.itemId) &&
        data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 140 &&
        isValidCategory(data.itemCategory) &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    // 1. Out-of-band Admin Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 2. Public Collector Profiles (Zero PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        (isSignedIn() && request.auth.uid == userId) ||
        (resource != null && resource.data.isPublicProfile == true) ||
        isAdmin()
      );
      allow list: if resource.data.isPublicProfile == true ||
        (isSignedIn() && resource.data.uid == request.auth.uid) ||
        isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            request.auth.uid == userId &&
            incoming().role == 'collector' &&
            incoming().plan == 'free' &&
            incoming().isVerifiedExpert == false &&
            incoming().isDemo == false &&
            incoming().collectionsCount == 0 &&
            incoming().piecesCount == 0
          ) ||
          (isAdmin() && incoming().isDemo == true)
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) && (
          isAdmin() ||
          // Action 1: Owner edits public cabinet details and privacy preferences
          (
            request.auth.uid == userId &&
            existing().uid == request.auth.uid &&
            incoming().uid == existing().uid &&
            incoming().role == existing().role &&
            incoming().plan == existing().plan &&
            incoming().isVerifiedExpert == existing().isVerifiedExpert &&
            incoming().isDemo == existing().isDemo &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'handle',
              'displayName',
              'bio',
              'avatarUrl',
              'location',
              'specialties',
              'goal',
              'isPublicProfile',
              'hideValues',
              'hideLocation',
              'onboardingCompleted',
              'collectionsCount',
              'piecesCount',
              'joinedLabel',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        (request.auth.uid == userId || isAdmin());

      // 3. Isolated Private Account & UK GDPR Consent Subcollection (Master Gate + PII Isolation)
      match /private/{docId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(docId) &&
          (request.auth.uid == userId || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidUserPrivateAccount(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivateAccount(incoming()) && (
            isAdmin() ||
            (
              request.auth.uid == userId &&
              existing().uid == request.auth.uid &&
              incoming().uid == existing().uid &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              exists(/databases/$(database)/documents/users/$(userId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email',
                'analyticsConsent',
                'marketingConsent',
                'aiTrainingOptOut',
                'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          (request.auth.uid == userId || isAdmin());
      }

      // 4. Isolated Private Item Acquisition Notes & Price Paid (Owner/Admin Only)
      match /itemPrivate/{itemId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          (request.auth.uid == userId || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isSignedIn() &&
          (
            (request.auth.uid == userId && resource.data.uid == request.auth.uid) ||
            isAdmin()
          );

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          request.auth.uid == userId &&
          isValidItemPrivateAccountGate(userId, itemId);

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          isValidItemPrivateRecord(incoming()) && (
            isAdmin() ||
            (
              request.auth.uid == userId &&
              existing().uid == request.auth.uid &&
              incoming().uid == existing().uid &&
              incoming().itemId == existing().itemId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              exists(/databases/$(database)/documents/users/$(userId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'acquiredDate',
                'acquiredPriceGbp',
                'privateNotes',
                'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          (request.auth.uid == userId || isAdmin());
      }

      // 4.5 User Saved Pieces Index
      match /saves/{itemId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          request.auth.uid == userId &&
          isValidItemSave(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().itemId == itemId &&
          incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(itemId) &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    function isValidItemPrivateAccountGate(userId, itemId) {
      return isValidItemPrivateRecord(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().uid == userId &&
        incoming().itemId == itemId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        (
          exists(/databases/$(database)/documents/items/$(itemId)) ||
          existsAfter(/databases/$(database)/documents/items/$(itemId))
        );
    }

    // 5. Collections
    match /collections/{collectionId} {
      allow get: if isValidId(collectionId) && (
        (resource != null && resource.data.visibility == 'public') ||
        (isSignedIn() && resource != null && resource.data.ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.visibility == 'public' ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(collectionId) &&
        isValidCollection(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            incoming().ownerId == request.auth.uid &&
            incoming().featured == false &&
            incoming().isDemo == false &&
            incoming().itemCount == 0 &&
            incoming().estimatedTotalMinGbp == 0 &&
            incoming().estimatedTotalMaxGbp == 0 &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ) ||
          (
            isAdmin() &&
            incoming().isDemo == true &&
            exists(/databases/$(database)/documents/users/$(incoming().ownerId))
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(collectionId) &&
        isValidCollection(incoming()) && (
          isAdmin() ||
          // Action 1: Owner updates collection details or piece/valuation totals
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().featured == existing().featured &&
            incoming().isDemo == existing().isDemo &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName',
              'ownerHandle',
              'title',
              'story',
              'coverImageUrl',
              'category',
              'visibility',
              'itemCount',
              'setTargetCount',
              'estimatedTotalMinGbp',
              'estimatedTotalMaxGbp',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(collectionId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 5.5 AI Expert Panel Chats (Strict Owner Only)
    match /panelChats/{itemId} {
      allow get: if isVerifiedUser() &&
        isValidId(itemId) &&
        resource != null &&
        resource.data.ownerId == request.auth.uid;
      allow list: if isVerifiedUser() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidPanelChatRecord(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidPanelChatRecord(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'personaId',
          'messages',
          'summary',
          'card',
          'confidence',
          'status',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(itemId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 6. Collectible Pieces
    match /items/{itemId} {
      allow get: if isValidId(itemId) && (
        (resource != null && resource.data.visibility == 'public') ||
        (isSignedIn() && resource != null && resource.data.ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.visibility == 'public' ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidCollectibleItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            incoming().ownerId == request.auth.uid &&
            incoming().isDemo == false &&
            exists(/databases/$(database)/documents/collections/$(incoming().collectionId)) &&
            get(/databases/$(database)/documents/collections/$(incoming().collectionId)).data.ownerId == request.auth.uid
          ) ||
          (
            isAdmin() &&
            incoming().isDemo == true &&
            exists(/databases/$(database)/documents/collections/$(incoming().collectionId))
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidCollectibleItem(incoming()) && (
          isAdmin() ||
          // Action 1: Owner edits piece details, category fields, valuation, or custom sort order
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().collectionId == existing().collectionId &&
            incoming().isDemo == existing().isDemo &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            exists(/databases/$(database)/documents/collections/$(existing().collectionId)) &&
            get(/databases/$(database)/documents/collections/$(existing().collectionId)).data.ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerHandle',
              'category',
              'visibility',
              'title',
              'titleLower',
              'story',
              'imageUrl',
              'thumbUrl',
              'photos',
              'attributes',
              'fieldConfidences',
              'year',
              'maker',
              'setNumber',
              'condition',
              'valueMinGbp',
              'valueMaxGbp',
              'valuationReason',
              'aiConfidence',
              'grail',
              'tags',
              'customOrder',
              'forSale',
              'mediaCredit',
              'helpedBy',
              'panelStatus',
              'panelConfirmedAt',
              'updatedAt'
            ])
          ) ||
          // Action 2: Owner moves piece to another collection owned by the same user
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().collectionId != existing().collectionId &&
            incoming().isDemo == existing().isDemo &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            exists(/databases/$(database)/documents/collections/$(incoming().collectionId)) &&
            get(/databases/$(database)/documents/collections/$(incoming().collectionId)).data.ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'collectionId',
              'visibility',
              'customOrder',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(itemId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      // 6.1 Likes (One like per user per item, enforced by doc id = uid)
      match /likes/{userId} {
        allow get, list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(userId) &&
          request.auth.uid == userId &&
          isValidItemLike(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().itemId == itemId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/items/$(itemId));

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(userId) &&
          (userId == request.auth.uid || isAdmin());
      }

      // 6.2 Saves (One bookmark per user per item, enforced by doc id = uid)
      match /saves/{userId} {
        allow get, list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(userId) &&
          request.auth.uid == userId &&
          isValidItemSave(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().itemId == itemId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/items/$(itemId));

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(userId) &&
          (userId == request.auth.uid || isAdmin());
      }

      // 6.3 Comments (Plain text <= 1,000 chars; author edits/deletes; item owner deletes)
      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(commentId) &&
          isValidItemComment(incoming()) &&
          incoming().id == commentId &&
          incoming().itemId == itemId &&
          incoming().authorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/items/$(itemId));

        allow update: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(commentId) &&
          isValidItemComment(incoming()) &&
          existing().authorId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().itemId == existing().itemId &&
          incoming().authorId == existing().authorId &&
          incoming().authorName == existing().authorName &&
          incoming().authorHandle == existing().authorHandle &&
          incoming().authorAvatarUrl == existing().authorAvatarUrl &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']);

        allow delete: if isVerifiedUser() &&
          isValidId(itemId) &&
          isValidId(commentId) &&
          (
            existing().authorId == request.auth.uid ||
            get(/databases/$(database)/documents/items/$(itemId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 7. Follows (Owner-only writes, public reads for counts and feed query)
    match /follows/{followId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(followId) &&
        isValidFollow(incoming()) &&
        incoming().followerId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(followId) &&
        (existing().followerId == request.auth.uid || isAdmin());
    }

    // 8. Reports (Verified user create, strictly admin read only)
    match /reports/{reportId} {
      allow get, list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    // 9. Fresh Finds (Public reads, owner-only create & delete, no edits by others or anyone)
    match /freshFinds/{findId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(findId) &&
        isValidFreshFind(incoming()) &&
        incoming().createdAt == request.time && (
          (incoming().ownerId == request.auth.uid && (!('isDemo' in incoming()) || incoming().isDemo == false)) ||
          (isAdmin() && incoming().isDemo == true)
        );

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(findId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 10. ID Corrections (Any verified user can suggest; item owner can accept/dismiss)
    match /idCorrections/{correctionId} {
      allow get, list: if isSignedIn();

      allow create: if isVerifiedUser() &&
        isValidId(correctionId) &&
        isValidIdCorrection(incoming()) &&
        incoming().suggesterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(correctionId) &&
        isValidIdCorrection(incoming()) && (
          isAdmin() ||
          (
            existing().itemOwnerId == request.auth.uid &&
            incoming().itemOwnerId == existing().itemOwnerId &&
            incoming().itemId == existing().itemId &&
            incoming().suggesterId == existing().suggesterId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(correctionId) &&
        (existing().suggesterId == request.auth.uid || existing().itemOwnerId == request.auth.uid || isAdmin());
    }

    // 11. Item Signals (Got One / Want One)
    match /itemSignals/{signalId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(signalId) &&
        isValidItemSignal(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(signalId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // 12. Wants (Wantlist items; public reads for Fresh Finds matching by category; owner writes)
    match /wants/{wantId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(wantId) &&
        isValidWant(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(wantId) &&
        isValidWant(incoming()) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category',
              'title',
              'keyFields',
              'notes',
              'maxPriceGbp',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(wantId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // 13. In-App Notifications (Recipients read; verified system/users create; recipient marks read)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        (request.query.limit <= 100 && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().userId != request.auth.uid &&
        incoming().read == false &&
        incoming().createdAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().type == existing().type &&
            incoming().itemId == existing().itemId &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(notificationId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // Validation Blueprint: MarketplaceListingRecord
    function isValidMarketplaceListing(data) {
      return data.keys().hasAll([
          'itemId',
          'sellerId',
          'sellerHandle',
          'sellerName',
          'title',
          'description',
          'photos',
          'priceGbp',
          'condition',
          'category',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'itemId',
          'sellerId',
          'sellerHandle',
          'sellerName',
          'sellerAvatarUrl',
          'title',
          'description',
          'photos',
          'priceGbp',
          'condition',
          'category',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.itemId) &&
        isValidId(data.sellerId) &&
        data.sellerHandle is string && data.sellerHandle.size() >= 2 && data.sellerHandle.size() <= 32 && data.sellerHandle.matches('^[a-z0-9_\\-]+$') &&
        data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
        (!('sellerAvatarUrl' in data) || (data.sellerAvatarUrl is string && data.sellerAvatarUrl.size() <= 2048)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.description is string && data.description.size() <= 1500 &&
        data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 6 &&
        isValidPhotoEntry(data.photos[0]) &&
        (data.priceGbp is int || data.priceGbp is float) && data.priceGbp >= 0 && data.priceGbp <= 10000000 &&
        data.condition is string && data.condition.size() >= 1 && data.condition.size() <= 80 &&
        isValidCategory(data.category) &&
        data.status is string && data.status in ['active', 'sold', 'withdrawn'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 14. Marketplace Listings
    match /marketplace/{listingId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(listingId) &&
        isValidMarketplaceListing(incoming()) &&
        incoming().sellerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/items/$(incoming().itemId)) &&
        get(/databases/$(database)/documents/items/$(incoming().itemId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser() &&
        isValidId(listingId) &&
        isValidMarketplaceListing(incoming()) && (
          isAdmin() ||
          (
            existing().sellerId == request.auth.uid &&
            incoming().sellerId == existing().sellerId &&
            incoming().itemId == existing().itemId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'description',
              'photos',
              'priceGbp',
              'condition',
              'status',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(listingId) &&
        (existing().sellerId == request.auth.uid || isAdmin());
    }

    // 14. Articles (Admin write-only or public read)
    match /articles/{articleId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
        isValidId(articleId) &&
        isValidArticle(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().publishedAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(articleId) &&
        isValidArticle(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().publishedAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'slug',
          'body',
          'category',
          'coverImage',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(articleId);
    }

    function isValidArticle(data) {
      return data.keys().hasAll([
          'title',
          'slug',
          'body',
          'category',
          'coverImage',
          'publishedAt',
          'authorId',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'slug',
          'body',
          'category',
          'coverImage',
          'publishedAt',
          'authorId',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 &&
        data.body is string && data.body.size() >= 10 && data.body.size() <= 20000 &&
        isValidCategory(data.category) &&
        data.coverImage is string && data.coverImage.size() <= 2048 &&
        data.publishedAt is timestamp &&
        isValidId(data.authorId) &&
        data.updatedAt is timestamp;
    }

    // 14. Valuation Snapshots (Portfolio daily estimate over time)
    match /users/{userId}/valuationSnapshots/{snapshotId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(snapshotId) &&
        request.auth.uid == userId &&
        incoming().keys().hasAll(['snapshotId', 'userId', 'totalMinGbp', 'totalMaxGbp', 'itemsCount', 'date', 'createdAt']) &&
        incoming().keys().hasOnly(['snapshotId', 'userId', 'totalMinGbp', 'totalMaxGbp', 'itemsCount', 'date', 'createdAt']) &&
        incoming().snapshotId == snapshotId &&
        incoming().userId == request.auth.uid &&
        (incoming().totalMinGbp is int || incoming().totalMinGbp is float) && incoming().totalMinGbp >= 0 &&
        (incoming().totalMaxGbp is int || incoming().totalMaxGbp is float) && incoming().totalMaxGbp >= incoming().totalMinGbp &&
        incoming().itemsCount is int && incoming().itemsCount >= 0 &&
        incoming().date is string && incoming().date.size() <= 40 &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // 15. Price Alerts (Notify when wanted item < target price or owned valuation moves > 15%)
    match /priceAlerts/{alertId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(alertId) &&
        incoming().keys().hasAll(['alertId', 'userId', 'targetType', 'targetId', 'title', 'thresholdType', 'thresholdValue', 'triggered', 'createdAt']) &&
        incoming().keys().hasOnly(['alertId', 'userId', 'targetType', 'targetId', 'title', 'thresholdType', 'thresholdValue', 'triggered', 'triggeredAt', 'createdAt']) &&
        incoming().alertId == alertId &&
        incoming().userId == request.auth.uid &&
        incoming().targetType is string && incoming().targetType in ['item', 'want'] &&
        isValidId(incoming().targetId) &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 140 &&
        incoming().thresholdType is string && incoming().thresholdType in ['below_price', 'gain_loss_pct'] &&
        (incoming().thresholdValue is int || incoming().thresholdValue is float) && incoming().thresholdValue >= 0 &&
        incoming().triggered is bool &&
        (!('triggeredAt' in incoming()) || incoming().triggeredAt is timestamp) &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(alertId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().alertId == existing().alertId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['triggered', 'triggeredAt']) &&
        incoming().triggered is bool &&
        (!('triggeredAt' in incoming()) || incoming().triggeredAt is timestamp);

      allow delete: if isSignedIn() && isValidId(alertId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 16. Swaps (Trade item(s) for item(s) with optional cash top-up, counter-offers, both confirm, status flow)
    match /swaps/{swapId} {
      allow get, list: if isSignedIn() && (
        resource.data.proposerId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(swapId) &&
        incoming().keys().hasAll([
          'swapId',
          'proposerId',
          'proposerHandle',
          'recipientId',
          'recipientHandle',
          'proposerItemIds',
          'recipientItemIds',
          'cashTopUpGbp',
          'cashPayer',
          'status',
          'proposerConfirmed',
          'recipientConfirmed',
          'createdAt',
          'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'swapId',
          'proposerId',
          'proposerHandle',
          'recipientId',
          'recipientHandle',
          'proposerItemIds',
          'recipientItemIds',
          'cashTopUpGbp',
          'cashPayer',
          'status',
          'proposerConfirmed',
          'recipientConfirmed',
          'note',
          'createdAt',
          'updatedAt'
        ]) &&
        incoming().swapId == swapId &&
        incoming().proposerId == request.auth.uid &&
        isValidId(incoming().recipientId) &&
        incoming().recipientId != request.auth.uid &&
        incoming().proposerHandle is string && incoming().proposerHandle.size() >= 2 && incoming().proposerHandle.size() <= 32 &&
        incoming().recipientHandle is string && incoming().recipientHandle.size() >= 2 && incoming().recipientHandle.size() <= 32 &&
        incoming().proposerItemIds is list && incoming().proposerItemIds.size() >= 1 && incoming().proposerItemIds.size() <= 10 &&
        incoming().recipientItemIds is list && incoming().recipientItemIds.size() >= 1 && incoming().recipientItemIds.size() <= 10 &&
        (incoming().cashTopUpGbp is int || incoming().cashTopUpGbp is float) && incoming().cashTopUpGbp >= 0 &&
        incoming().cashPayer is string && incoming().cashPayer in ['none', 'proposer', 'recipient'] &&
        incoming().status is string && incoming().status in ['proposed', 'countered', 'accepted', 'shipped', 'completed', 'declined', 'cancelled'] &&
        incoming().proposerConfirmed is bool &&
        incoming().recipientConfirmed is bool &&
        (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 1000)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(swapId) &&
        (existing().proposerId == request.auth.uid || existing().recipientId == request.auth.uid || isAdmin()) &&
        incoming().swapId == existing().swapId &&
        incoming().proposerId == existing().proposerId &&
        incoming().recipientId == existing().recipientId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'proposerItemIds',
          'recipientItemIds',
          'cashTopUpGbp',
          'cashPayer',
          'status',
          'proposerConfirmed',
          'recipientConfirmed',
          'note',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(swapId) &&
        (existing().proposerId == request.auth.uid || isAdmin());
    }

    // 17. Weekly Digests ('Your collection this week' digest in-app)
    match /users/{userId}/weeklyDigests/{digestId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(digestId) &&
        request.auth.uid == userId &&
        incoming().keys().hasAll(['digestId', 'userId', 'weekLabel', 'summaryText', 'topRisers', 'newPiecesCount', 'valuationDeltaGbp', 'createdAt']) &&
        incoming().keys().hasOnly(['digestId', 'userId', 'weekLabel', 'summaryText', 'topRisers', 'newPiecesCount', 'valuationDeltaGbp', 'createdAt']) &&
        incoming().digestId == digestId &&
        incoming().userId == request.auth.uid &&
        incoming().weekLabel is string && incoming().weekLabel.size() <= 40 &&
        incoming().summaryText is string && incoming().summaryText.size() <= 1500 &&
        incoming().topRisers is list && incoming().topRisers.size() <= 5 &&
        incoming().newPiecesCount is int && incoming().newPiecesCount >= 0 &&
        (incoming().valuationDeltaGbp is int || incoming().valuationDeltaGbp is float) &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // Phase 3A: Community threads and replies
    function isValidCommunityThread(data) {
      return data.keys().hasAll([
          'id', 'category', 'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
          'title', 'body', 'replyCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'category', 'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
          'title', 'body', 'photoUrl', 'linkedItemId', 'poll', 'replyCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidCategory(data.category) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 32 &&
        data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 2048 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.body is string && data.body.size() <= 3000 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048)) &&
        (!('linkedItemId' in data) || isValidId(data.linkedItemId)) &&
        (!('poll' in data) || data.poll is map) &&
        data.replyCount is int && data.replyCount >= 0 && data.replyCount <= 100000;
    }

    match /communityThreads/{threadId} {
      allow get, list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(threadId) &&
        isValidCommunityThread(incoming()) &&
        incoming().id == threadId &&
        incoming().authorId == request.auth.uid &&
        incoming().replyCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('poll' in incoming()) || (
          incoming().poll.keys().hasOnly(['question', 'options', 'votes', 'userVotes']) &&
          incoming().poll.options is list && incoming().poll.options.size() >= 2 && incoming().poll.options.size() <= 4 &&
          incoming().poll.userVotes.size() == 0
        ));

      allow update: if isVerifiedUser() && isValidId(threadId) && isValidCommunityThread(incoming()) && (
        isAdmin() ||
        // Author edits title or body
        (
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'updatedAt'])
        ) ||
        // Any verified member adds a reply: reply count goes up by exactly one
        (
          incoming().replyCount == existing().replyCount + 1 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['replyCount'])
        ) ||
        // Any verified member votes once in a poll
        (
          'poll' in existing() &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['poll', 'updatedAt']) &&
          !(request.auth.uid in existing().poll.userVotes) &&
          request.auth.uid in incoming().poll.userVotes &&
          incoming().poll.userVotes.size() == existing().poll.userVotes.size() + 1 &&
          incoming().poll.question == existing().poll.question &&
          incoming().poll.options == existing().poll.options
        )
      );

      allow delete: if isVerifiedUser() && isValidId(threadId) &&
        (existing().authorId == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow get, list: if true;

        allow create: if isVerifiedUser() &&
          isValidId(replyId) &&
          incoming().keys().hasAll(['id', 'threadId', 'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl', 'text', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['id', 'threadId', 'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl', 'text', 'photoUrl', 'linkedItemId', 'createdAt', 'updatedAt']) &&
          incoming().id == replyId &&
          incoming().threadId == threadId &&
          incoming().authorId == request.auth.uid &&
          incoming().authorName is string && incoming().authorName.size() >= 1 && incoming().authorName.size() <= 80 &&
          incoming().authorHandle is string && incoming().authorHandle.size() >= 2 && incoming().authorHandle.size() <= 32 &&
          incoming().authorAvatarUrl is string && incoming().authorAvatarUrl.size() <= 2048 &&
          incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 1500 &&
          (!('photoUrl' in incoming()) || (incoming().photoUrl is string && incoming().photoUrl.size() <= 2048)) &&
          (!('linkedItemId' in incoming()) || isValidId(incoming().linkedItemId)) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/communityThreads/$(threadId));

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'listingId', 'itemId', 'buyerId', 'buyerHandle', 'sellerId', 'sellerHandle', 'title', 'priceGbp', 'platformCommissionRate', 'platformCommissionGbp', 'sellerPayoutDue', 'stripeSessionId', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'listingId', 'itemId', 'buyerId', 'buyerHandle', 'sellerId', 'sellerHandle', 'title', 'priceGbp', 'platformCommissionRate', 'platformCommissionGbp', 'sellerPayoutDue', 'stripeSessionId', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        isValidId(data.listingId) &&
        isValidId(data.itemId) &&
        isValidId(data.buyerId) &&
        data.buyerHandle is string && data.buyerHandle.size() >= 2 && data.buyerHandle.size() <= 32 &&
        isValidId(data.sellerId) &&
        data.sellerHandle is string && data.sellerHandle.size() >= 2 && data.sellerHandle.size() <= 32 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.priceGbp is number && data.priceGbp >= 0 && data.priceGbp <= 10000000 &&
        data.platformCommissionRate is number && data.platformCommissionRate >= 0 && data.platformCommissionRate <= 1 &&
        data.platformCommissionGbp is number && data.platformCommissionGbp >= 0 &&
        data.sellerPayoutDue is number && data.sellerPayoutDue >= 0 &&
        (data.sellerPayoutDue + data.platformCommissionGbp) == data.priceGbp &&
        data.stripeSessionId is string && data.stripeSessionId.size() >= 1 && data.stripeSessionId.size() <= 256 &&
        data.status in ['pending_payment', 'paid', 'payment_failed', 'cancelled', 'refunded'] &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (
          request.query.limit <= 100 &&
          request.query.filters.size() == 1 &&
          request.query.filters[0].field == 'buyerId' &&
          request.query.filters[0].op == '==' &&
          request.query.filters[0].value == request.auth.uid
        ) ||
        (
          request.query.limit <= 100 &&
          request.query.filters.size() == 1 &&
          request.query.filters[0].field == 'sellerId' &&
          request.query.filters[0].op == '==' &&
          request.query.filters[0].value == request.auth.uid
        )
      );

      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().id == orderId &&
        incoming().buyerId == request.auth.uid &&
        incoming().buyerId != incoming().sellerId &&
        incoming().status == 'pending_payment' &&
        exists(/databases/$(database)/documents/marketplace/$(incoming().listingId)) &&
        get(/databases/$(database)/documents/marketplace/$(incoming().listingId)).data.status == 'active' &&
        get(/databases/$(database)/documents/marketplace/$(incoming().listingId)).data.sellerId == incoming().sellerId &&
        get(/databases/$(database)/documents/marketplace/$(incoming().listingId)).data.itemId == incoming().itemId &&
        get(/databases/$(database)/documents/marketplace/$(incoming().listingId)).data.priceGbp == incoming().priceGbp &&
        get(/databases/$(database)/documents/marketplace/$(incoming().listingId)).data.title == incoming().title;

      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        existing().sellerId == request.auth.uid &&
        (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            incoming().status == 'paid' &&
            existing().status == 'pending_payment' &&
            incoming().updatedAt == request.time
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            incoming().status == 'cancelled' &&
            existing().status in ['pending_payment', 'payment_failed'] &&
            incoming().updatedAt == request.time
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(orderId) &&
        (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin()) &&
        existing().status in ['pending_payment', 'payment_failed', 'cancelled'];
    }
}
}
