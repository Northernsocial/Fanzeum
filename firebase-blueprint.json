{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Out-of-band administrator membership document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public collector cabinet profile containing zero PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "maxLength": 600
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "location": {
          "type": "string",
          "maxLength": 80
        },
        "specialties": {
          "type": "array",
          "description": "Up to 10 category slugs collected by this user."
        },
        "goal": {
          "type": "string",
          "enum": ["exhibit", "complete_set", "sell", "learn"],
          "maxLength": 24
        },
        "role": {
          "type": "string",
          "enum": ["collector", "expert", "store", "admin"],
          "maxLength": 16
        },
        "plan": {
          "type": "string",
          "enum": ["free", "premium", "store"],
          "maxLength": 16
        },
        "isVerifiedExpert": {
          "type": "boolean"
        },
        "isPublicProfile": {
          "type": "boolean"
        },
        "hideValues": {
          "type": "boolean"
        },
        "hideLocation": {
          "type": "boolean"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "collectionsCount": {
          "type": "integer"
        },
        "piecesCount": {
          "type": "integer"
        },
        "joinedLabel": {
          "type": "string",
          "maxLength": 40
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "handle",
        "displayName",
        "bio",
        "avatarUrl",
        "location",
        "specialties",
        "goal",
        "role",
        "plan",
        "isVerifiedExpert",
        "isPublicProfile",
        "hideValues",
        "hideLocation",
        "onboardingCompleted",
        "collectionsCount",
        "piecesCount",
        "joinedLabel",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Strictly isolated PII and UK GDPR consent settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "analyticsConsent": {
          "type": "boolean"
        },
        "marketingConsent": {
          "type": "boolean"
        },
        "aiTrainingOptOut": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "analyticsConsent",
        "marketingConsent",
        "aiTrainingOptOut",
        "createdAt",
        "updatedAt"
      ]
    },
    "ItemPrivateRecord": {
      "title": "ItemPrivateRecord",
      "description": "Owner-only private acquisition date, price paid, and private notes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acquiredDate": {
          "type": "string",
          "maxLength": 40
        },
        "acquiredPriceGbp": {
          "type": "number"
        },
        "privateNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "itemId",
        "acquiredDate",
        "acquiredPriceGbp",
        "privateNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CollectionRecord": {
      "title": "CollectionRecord",
      "description": "A collector's themed collection with set completion target and GBP totals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "story": {
          "type": "string",
          "maxLength": 2500
        },
        "coverImageUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "category": {
          "type": "string",
          "enum": [
            "stamps",
            "football_cards",
            "trading_cards",
            "coins",
            "comics",
            "vinyl",
            "toys",
            "memorabilia"
          ],
          "maxLength": 32
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "followers", "private"],
          "maxLength": 16
        },
        "itemCount": {
          "type": "integer"
        },
        "setTargetCount": {
          "type": "integer"
        },
        "estimatedTotalMinGbp": {
          "type": "number"
        },
        "estimatedTotalMaxGbp": {
          "type": "number"
        },
        "featured": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "ownerHandle",
        "title",
        "story",
        "coverImageUrl",
        "category",
        "visibility",
        "itemCount",
        "setTargetCount",
        "estimatedTotalMinGbp",
        "estimatedTotalMaxGbp",
        "featured",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "CollectibleItemRecord": {
      "title": "CollectibleItemRecord",
      "description": "Individual collectible piece with category-specific fields, multi-photo Storage URLs, and GBP estimate.",
      "type": "object",
      "properties": {
        "collectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "stamps",
            "football_cards",
            "trading_cards",
            "coins",
            "comics",
            "vinyl",
            "toys",
            "memorabilia"
          ],
          "maxLength": 32
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "followers", "private"],
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "titleLower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "story": {
          "type": "string",
          "maxLength": 1500
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "thumbUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "photos": {
          "type": "array",
          "description": "1 to 6 ItemPhoto objects pointing to Firebase Storage or public URLs."
        },
        "attributes": {
          "type": "object",
          "description": "Category-specific key/value attributes."
        },
        "fieldConfidences": {
          "type": "object",
          "description": "Per-field AI confidence levels."
        },
        "year": {
          "type": "string",
          "maxLength": 32
        },
        "maker": {
          "type": "string",
          "maxLength": 120
        },
        "setNumber": {
          "type": "string",
          "maxLength": 80
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "valueMinGbp": {
          "type": "number"
        },
        "valueMaxGbp": {
          "type": "number"
        },
        "valuationReason": {
          "type": "string",
          "maxLength": 320
        },
        "aiConfidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "manual"],
          "maxLength": 16
        },
        "grail": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "description": "Up to 12 lowercase search tags."
        },
        "customOrder": {
          "type": "integer"
        },
        "forSale": {
          "type": "boolean"
        },
        "mediaCredit": {
          "type": "object",
          "description": "Optional public-domain / Creative Commons attribution."
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "collectionId",
        "ownerId",
        "ownerHandle",
        "category",
        "visibility",
        "title",
        "titleLower",
        "story",
        "imageUrl",
        "thumbUrl",
        "photos",
        "attributes",
        "fieldConfidences",
        "year",
        "maker",
        "setNumber",
        "condition",
        "valueMinGbp",
        "valueMaxGbp",
        "valuationReason",
        "aiConfidence",
        "grail",
        "tags",
        "customOrder",
        "forSale",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "FollowRecord": {
      "title": "FollowRecord",
      "description": "Owner-only follow record for following a category or another collector.",
      "type": "object",
      "properties": {
        "followerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["category", "user"],
          "maxLength": 16
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "followerId",
        "targetType",
        "targetId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Out-of-band administrator registry."
    },
    "/panelChats/{itemId}": {
      "schema": { "$ref": "#/entities/PanelChatRecord" },
      "description": "Interactive AI Expert Panel chat and structured card for an item."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public collector cabinet profiles (zero PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Strictly isolated PII and UK GDPR consent records."
    },
    "/users/{userId}/itemPrivate/{itemId}": {
      "schema": { "$ref": "#/entities/ItemPrivateRecord" },
      "description": "Strictly isolated owner-only purchase price, acquisition date, and private notes."
    },
    "/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/CollectionRecord" },
      "description": "Collector collections with visibility controls and set targets."
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/CollectibleItemRecord" },
      "description": "Individual pieces referencing owned collections and Storage photo URLs."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowRecord" },
      "description": "Owner-only follow records for categories and collectors."
    }
  }
}
